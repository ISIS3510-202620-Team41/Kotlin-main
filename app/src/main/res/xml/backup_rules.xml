<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- The device encryption key cannot be restored. Exclude both legacy and
         encrypted credentials, and start account metadata fresh after restore. -->
    <exclude domain="sharedpref" path="auth.xml" />
    <exclude domain="sharedpref" path="auth_tokens.xml" />
    <exclude domain="file" path="datastore/app_preferences.preferences_pb" />
</full-backup-content>
